---
interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
}

const { title, description, type = 'website' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color: #171717;
    background: #faf9f6;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.5rem;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
  }

  a {
    color: #305f87;
    text-decoration: underline;
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.15em;
  }

  .site-shell {
    width: min(100% - 2rem, 760px);
    margin: 0 auto;
    padding: 2.5rem 0 4rem;
  }

  .site-nav,
  .site-footer,
  .eyebrow {
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 0.65rem;
  }

  .site-nav {
    margin-bottom: 3rem;
  }

  .site-footer {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid #d9d5ce;
  }

  .page-title,
  .prose > h1 {
    max-width: 17ch;
    margin: 0 0 1rem;
    font-size: clamp(2rem, 7vw, 3.35rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .prose > h1 + p,
  .lede {
    margin: 0 0 3rem;
    color: #625e57;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .prose h2,
  .section-title {
    margin: 2.75rem 0 0.8rem;
    font-size: 1.35rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .prose p,
  .prose li,
  .body-copy {
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .prose p {
    margin: 0 0 1.15rem;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.25rem;
  }

  .prose li {
    margin-bottom: 0.45rem;
  }

  .prose blockquote {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 3px solid #a85f3d;
    color: #3d3933;
  }

  .prose blockquote p {
    font-size: 1rem;
    line-height: 1.5;
  }

  .prose table {
    display: block;
    width: 100%;
    margin: 1.75rem 0;
    overflow-x: auto;
    border-collapse: collapse;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 0.64rem;
    line-height: 1.45;
  }

  .prose th,
  .prose td {
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid #d9d5ce;
    text-align: left;
    vertical-align: top;
  }

  .prose th {
    color: #625e57;
    font-weight: 600;
  }

  .link-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link-list li {
    margin-bottom: 0.65rem;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .writing-entry {
    padding-left: 1rem;
    border-left: 3px solid #a85f3d;
  }

  .writing-entry a {
    font-size: 1rem;
    line-height: 1.35;
  }

  .writing-entry p {
    margin: 0.55rem 0 0;
    color: #625e57;
  }

  @media (max-width: 560px) {
    .site-shell {
      width: min(100% - 1.4rem, 760px);
      padding-top: 1.5rem;
    }

    .site-nav {
      margin-bottom: 2rem;
    }
  }
</style>
